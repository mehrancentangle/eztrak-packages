{
  "name": "@eztrak/shared",
  "version": "0.13.7",
  "homepage": "https://github.com/mehrancentangle/eztrak-packages",
  "description": "Shared hooks, utils, and UI for Eztrak federation apps",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.mjs",
      "require": "./dist/utils/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.mjs",
      "require": "./dist/hooks/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.mjs",
      "require": "./dist/components/index.js"
    },
    "./components/tabs.css": "./dist/components/tabs/styles.css",
    "./components/loader.css": "./dist/components/Loader/Loader.css"
  },
  "scripts": {
    "build": "tsup && node -e \"const fs=require('fs');const tabs='dist/components/tabs';fs.mkdirSync(tabs,{recursive:true});fs.copyFileSync('src/components/tabs/styles.css',tabs+'/styles.css');const loader='dist/components/Loader';fs.mkdirSync(loader,{recursive:true});fs.copyFileSync('src/components/Loader/Loader.css',loader+'/Loader.css')\"",
    "prepublishOnly": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.1"
  },
  "peerDependencies": {
    "@reduxjs/toolkit": "^2.0.0",
    "@tippyjs/react": "^4.0.0",
    "framer-motion": "^11.0.0 || ^12.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-hot-toast": "^2.0.0",
    "react-icons": "^5.0.0",
    "react-router-dom": "^6.0.0 || ^7.0.0",
    "react-select": "^5.0.0",
    "react-tooltip": "^5.28.0",
    "sweetalert2": "^11.0.0",
    "tippy.js": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "react-router-dom": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@tailwindcss/vite": "^4.3.0",
    "@tippyjs/react": "^4.2.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "framer-motion": "^12.23.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.0.0",
    "react-select": "^5.10.2",
    "react-tooltip": "^5.28.0",
    "storybook": "^8.6.18",
    "sweetalert2": "^11.22.0",
    "tailwindcss": "^4.3.0",
    "tippy.js": "^6.3.7",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.16"
  }
}
