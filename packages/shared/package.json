{
  "name": "@eztrak/shared",
  "version": "0.4.1",

  "homepage": "https://github.com/mehrancentangle/eztrak-packages",

  "description": "Shared hooks, utils, and UI for Eztrak federation apps",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": ["*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.mjs",
      "require": "./dist/utils/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.mjs",
      "require": "./dist/hooks/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.mjs",
      "require": "./dist/components/index.js"
    },
    "./components/tabs.css": "./dist/components/tabs/styles.css"
  },
  "scripts": {
    "build": "tsup && node -e \"const fs=require('fs');const p='dist/components/tabs';fs.mkdirSync(p,{recursive:true});fs.copyFileSync('src/components/tabs/styles.css',p+'/styles.css')\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.1"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0 || ^7.0.0",
    "react-hot-toast": "^2.0.0",
    "sweetalert2": "^11.0.0"
  },
  "peerDependenciesMeta": {
    "react-router-dom": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.0",
    "react-hot-toast": "^2.5.2",
    "sweetalert2": "^11.22.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  }
}
